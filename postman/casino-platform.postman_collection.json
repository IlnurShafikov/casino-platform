{
  "info": {
    "name": "casino-platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "wallet_url", "value": "http://localhost:8081" },
    { "key": "bet_url", "value": "http://localhost:8082" },
    { "key": "token", "value": "" },
    { "key": "user_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"email\": \"test@example.com\"\n}"
            },
            "url": "{{wallet_url}}/auth/token"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Create wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{user_id}}\n}" },
            "url": "{{wallet_url}}/wallets"
          }
        },
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{wallet_url}}/wallets/{{user_id}}/balance"
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10000\n}" },
            "url": "{{wallet_url}}/wallets/{{user_id}}/deposit"
          }
        },
        {
          "name": "Debit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"reference_id\": \"1\",\n  \"reference_type\": \"BET\"\n}"
            },
            "url": "{{wallet_url}}/wallets/{{user_id}}/debit"
          }
        }
      ]
    },
    {
      "name": "Bet",
      "item": [
        {
          "name": "Place bet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('bet_id', body.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"game_type\": \"slot\"\n}"
            },
            "url": "{{bet_url}}/bets"
          }
        },
        {
          "name": "Get bet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bet_url}}/bets/{{bet_id}}"
          }
        }
      ]
    }
  ]
}
